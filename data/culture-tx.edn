#:culture{:id "tza.dish.ugali", :name "Ugali", :country "TZA", :kind :dish, :summary "Cornmeal porridge cooked in boiling water or milk to a stiff, dough-like consistency; the most common staple starch of the African Great Lakes region, shared across Tanzania, Kenya, Uganda and South Sudan, and added to the UNESCO Representative List of the Intangible Cultural Heritage of Humanity in 2017.", :url "https://en.wikipedia.org/wiki/Ugali", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "tza.dish.mishkaki", :name "Mishkaki", :country "TZA", :kind :dish, :summary "Tanzanian skewers of marinated grilled beef, per the Wikipedia article on Tanzanian cuisine.", :url "https://en.wikipedia.org/wiki/Tanzanian_cuisine", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "tza.dish.mkate-wa-kumimina", :name "Mkate wa kumimina", :country "TZA", :kind :dish, :summary "Zanzibari rice bread, listed among snack foods in the Wikipedia article on Tanzanian cuisine.", :url "https://en.wikipedia.org/wiki/Tanzanian_cuisine", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "tza.product.tanzanite", :name "Tanzanite", :country "TZA", :kind :product, :summary "Blue and violet variety of the mineral zoisite, exclusively found in Tanzania; named by Tiffany & Co. after the country following its discovery in 1967, making Tanzania the sole source of this gemstone.", :url "https://en.wikipedia.org/wiki/Tanzanite", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "tza.craft.tingatinga-painting", :name "Tingatinga painting", :country "TZA", :kind :craft, :summary "East African painting style, one of the most widely represented forms of tourist-oriented paintings in Tanzania and Kenya, named after Tanzanian painter Edward Saidi Tingatinga and traditionally made with bicycle paint on masonite.", :url "https://en.wikipedia.org/wiki/Tingatinga_(painting)", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "tza.festival.sauti-za-busara", :name "Sauti za Busara", :country "TZA", :kind :festival, :summary "African music festival held every year in February in Zanzibar, Tanzania, centered at the Old Fort with events throughout Stone Town; one of East Africa's largest music festivals, showcasing genres from traditional Taarab to contemporary Tanzanian pop and hip-hop.", :url "https://en.wikipedia.org/wiki/Sauti_za_Busara", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "tza.heritage.stone-town-zanzibar", :name "Stone Town", :country "TZA", :kind :heritage, :summary "Historic old quarter of Zanzibar City, designated a UNESCO World Heritage Site in 2000, renowned for architecture blending Arab, Persian, Indian, and European influences and its role as a center of the 19th-century spice and slave trades.", :url "https://en.wikipedia.org/wiki/Stone_Town", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "tza.heritage.ngorongoro-conservation-area", :name "Ngorongoro Conservation Area", :country "TZA", :kind :heritage, :summary "Protected area in Ngorongoro District, Tanzania, designated a UNESCO World Heritage Site in 1979 for its natural significance and later recognized for its cultural and anthropological importance.", :url "https://en.wikipedia.org/wiki/Ngorongoro_Conservation_Area", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
]
